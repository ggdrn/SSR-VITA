+#ifdef HAVE_SHADER_CACHE
+// Optional application diagnostics: 0 hit, 1 miss, 2 saved, 3 I/O error,
+// 4 actual compiler invocation. No dependency on an application's logger.
+void vgl_shader_cache_event(unsigned event) __attribute__((weak));
+static void shader_cache_event(unsigned event) {
+  if (vgl_shader_cache_event) vgl_shader_cache_event(event);
+}
+static GLboolean load_cached_shader(const char *fname, shader *s, GLboolean bindings) {
+  SceUID fd = sceIoOpen(fname, SCE_O_RDONLY, 0777);
+  if (fd < 0) { shader_cache_event(1); return GL_FALSE; }
+  SceOff len = sceIoLseek(fd, 0, SCE_SEEK_END);
+  void *buf = NULL;
+  GLboolean valid = GL_FALSE;
+  GLboolean corrupt = len < 32 || len > 1024 * 1024;
+  // Bound native allocation and reject interrupted/short writes before the
+  // unserializer walks variable-length uniform metadata.
+  if (len >= 32 && len <= 1024 * 1024 && sceIoLseek(fd, 0, SCE_SEEK_SET) >= 0) {
+    buf = vglMalloc((size_t)len);
+    if (buf && sceIoRead(fd, buf, (size_t)len) == len) {
+      uint32_t matrices;
+      memcpy(&matrices, buf, sizeof(matrices));
+      size_t prefix = 4 + (size_t)matrices * 4;
+      if (matrices <= 4096 && prefix <= (size_t)len) {
+        if (bindings) prefix += sizeof(binds_map);
+#ifdef HAVE_GLSL_TEXTURE_SIZE
+        if (prefix < (size_t)len) {
+          unsigned samplers = ((uint8_t *)buf)[prefix++];
+          if (samplers <= SCE_GXM_MAX_TEXTURE_UNITS) prefix += samplers * sizeof(glsl_samplers_info);
+          else prefix = (size_t)len;
+        }
+#endif
+        if (prefix <= (size_t)len && (size_t)len - prefix >= 32) {
+          uint8_t *gxp = (uint8_t *)buf + prefix;
+          uint32_t program_size;
+          memcpy(&program_size, gxp + 8, sizeof(program_size));
+          if (!memcmp(gxp, "GXP", 4) && program_size >= 32 && program_size <= (size_t)len - prefix) valid = GL_TRUE;
+        }
+      }
+      corrupt = !valid;
+    }
+  }
+  sceIoClose(fd);
+  if (valid) {
+    unserialize_shader(buf, (size_t)len, s, bindings);
+    valid = s->prog != NULL;
+  }
+  vgl_free(buf);
+  if (valid) shader_cache_event(0);
+  else { shader_cache_event(3); shader_cache_event(1); if (corrupt) sceIoRemove(fname); }
+  return valid;
+}
+#endif

+#if !defined(HAVE_SINGLE_THREADED_GC) || defined(HAVE_PTHREAD)
+// Drain the frame-job permits before submitting an emergency collection.
+// A single permit does not acknowledge completion: the semaphore starts with
+// FRAME_PURGE_FREQ permits. Holding all of them lets the next returned permit
+// acknowledge this job, then restores the normal frame scheduling capacity.
+static void gpu_wait_emergency_collection(void) {
+	if (sceKernelWaitSema(gc_mutex[1], FRAME_PURGE_FREQ, NULL) < 0) return;
+	if (sceKernelSignalSema(gc_mutex[0], 1) < 0) {
+		sceKernelSignalSema(gc_mutex[1], FRAME_PURGE_FREQ);
+		return;
+	}
+	int completed = sceKernelWaitSema(gc_mutex[1], 1, NULL);
+	sceKernelSignalSema(gc_mutex[1], completed < 0 ? FRAME_PURGE_FREQ - 1 : FRAME_PURGE_FREQ);
+}
+#endif

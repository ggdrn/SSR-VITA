diff --git a/source/custom_shaders.c b/source/custom_shaders.c
index 1d410cb..099a64c 100644
--- a/source/custom_shaders.c
+++ b/source/custom_shaders.c
@@ -2438,6 +2438,13 @@ void glLinkProgram(GLuint progr) {
 				vgl_compile_shader(p->fshader, GL_TRUE);
 			}
 		}
+		// A shader that failed to translate/compile has no GXM program; linking
+		// would dereference it, so leave the program unlinked instead.
+		if (!p->vshader->prog || !p->fshader->prog) {
+			vgl_log("%s:%d: %s: %s shader failed to compile.\n", __FILE__, __LINE__, __func__, p->vshader->prog ? "fragment" : "vertex");
+			glsl_sema_mode = VGL_MODE_POSTPONED;
+			return;
+		}
 
 		// Setting progressive default attribute bindings
 		set_default_attrib_binding();
